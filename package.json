{
  "name": "@1agents/session-reader",
  "version": "0.6.2",
  "description": "Read Plane: cross-agent session discovery, turn inspection, workspace aggregation and distillation from raw local session files.",
  "keywords": [
    "claude-code",
    "codex",
    "antigravity",
    "grok",
    "deepseek",
    "session",
    "transcript",
    "jsonl",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottzx/session-reader.git"
  },
  "bugs": {
    "url": "https://github.com/scottzx/session-reader/issues"
  },
  "homepage": "https://github.com/scottzx/session-reader#readme",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/dsh/client.d.ts",
      "default": "./dist/src/dsh/client.js"
    },
    "./dsh": {
      "types": "./dist/src/dsh/index.d.ts",
      "import": "./dist/src/dsh/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "bin": {
    "1session": "dist/bin/1session.js"
  },
  "files": [
    "dist",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-client.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/session-reader.test.ts test/dsh-adapter.test.ts test/web.test.ts",
    "prepack": "npm run build",
    "1session": "tsx bin/1session.ts"
  },
  "engines": {
    "node": ">=22.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@1agents/chat-ui": "^0.1.0",
    "@1agents/dreammate-network": "^0.3.0",
    "@1agents/dreammate-node": "^0.4.0",
    "preact": "^10.19.6"
  }
}
